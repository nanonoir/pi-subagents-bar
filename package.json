{
  "name": "pi-subagents-bar",
  "version": "0.1.0",
  "description": "Live subagent monitoring for the Pi Atelier sidebar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanonoir/pi-subagents-bar.git"
  },
  "homepage": "https://github.com/nanonoir/pi-subagents-bar#readme",
  "bugs": "https://github.com/nanonoir/pi-subagents-bar/issues",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:monitor": "vitest run tests/monitor.test.ts",
    "test:foreground": "vitest run tests/foreground.test.ts",
    "test:notices": "vitest run tests/notices.test.ts",
    "test:cost": "vitest run tests/cost.test.ts",
    "test:index": "vitest run tests/index.test.ts",
    "test:renderer": "vitest run tests/atelier.test.ts",
    "test:sidebar": "vitest run tests/atelier.test.ts tests/index.test.ts",
    "test:providers": "node scripts/provider-smoke.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-atelier",
    "subagents"
  ],
  "author": "Nahuel Noir",
  "license": "ISC",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "private": true,
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "src/",
    "tests/",
    "scripts/",
    "docs/manual-smoke.md",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
